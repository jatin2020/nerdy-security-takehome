# ==============================================================================
# Security Alert Triage Service — Environment Configuration
# ==============================================================================

# API Authentication Token (Shared Secret)
# Used in the 'X-API-Token' header or 'Authorization: Bearer <token>'
TRIAGE_API_TOKEN=sec-token-nerdy-local-2026

# LLM Execution Mode: 'mock' (offline deterministic double) or 'real' (live API)
LLM_MODE=mock

# Live LLM Configuration (Only used when LLM_MODE=real)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0
MAX_AGENT_TURNS=4
